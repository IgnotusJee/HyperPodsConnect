{
  "id": "sony-linkbuds-s-ambient-level-boundaries",
  "deviceAlias": "sony-linkbuds-s-01",
  "appPackage": "com.sony.songpal.mdr",
  "expectedAppVersion": "13.2.0",
  "mode": "guided",
  "transportCandidates": [
    "GATT"
  ],
  "steps": [
    {
      "id": "baseline_level_10",
      "prompt": "切换到环境声音并确认当前等级为 10，不调整滑块",
      "settleSeconds": 5
    },
    {
      "id": "minimum_level",
      "prompt": "将环境声音等级调整到官方界面允许的最低值",
      "settleSeconds": 6
    },
    {
      "id": "maximum_level",
      "prompt": "将环境声音等级调整到官方界面允许的最高值",
      "settleSeconds": 6
    },
    {
      "id": "restore_level_10",
      "prompt": "将环境声音等级恢复到 10",
      "settleSeconds": 6
    }
  ],
  "repeat": 1,
  "forbiddenUiTerms": [
    "固件升级",
    "固件更新",
    "恢复出厂设置",
    "解除配对",
    "删除设备",
    "查找设备",
    "查找耳机",
    "关闭音频设备",
    "更多信息"
  ],
  "targetDeviceNames": [
    "LinkBuds S"
  ]
}
