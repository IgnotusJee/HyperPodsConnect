{
  "id": "sony-linkbuds-s-eq-preset-implementation",
  "deviceAlias": "sony-linkbuds-s-01",
  "appPackage": "moe.chenxy.oppopods",
  "expectedAppVersion": "2.0.7",
  "mode": "automated-whitelist",
  "transportCandidates": [
    "GATT"
  ],
  "steps": [
    {
      "id": "baseline_bass_boost",
      "prompt": "确认初始 GET_PARAM 读回 Bass Boost",
      "settleSeconds": 3
    },
    {
      "id": "set_speech",
      "prompt": "单次切换到 Speech 并等待 ACK、NTFY 与 GET_PARAM readback",
      "settleSeconds": 6
    },
    {
      "id": "restore_bass_boost",
      "prompt": "单次恢复 Bass Boost 并等待 ACK、NTFY 与 GET_PARAM readback",
      "settleSeconds": 6
    }
  ],
  "repeat": 1,
  "forbiddenUiTerms": [
    "自定义均衡器",
    "固件升级",
    "固件更新",
    "恢复出厂设置",
    "解除配对",
    "删除设备",
    "查找设备",
    "查找耳机",
    "关闭音频设备",
    "更多信息"
  ],
  "targetDeviceNames": [
    "LinkBuds S"
  ]
}
