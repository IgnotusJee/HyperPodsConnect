    },
    {
      "id": "adjacent_level",
      "prompt": "将环境声音等级只调整一级，例如 10 到 11",
      "settleSeconds": 6
    },
    {
      "id": "restore_level",
      "prompt": "恢复到本轮初始环境声音等级",
      "settleSeconds": 6
    }
  ],
  "repeat": 3,
  "forbiddenUiTerms": [
    "固件升级",
    "固件更新",
    "恢复出厂设置",
    "解除配对",
    "删除设备",
    "查找设备",
    "查找耳机",
    "关闭音频设备",
